{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BingkongPip",
  "version": "0.1.0",
  "identifier": "com.bingkong.pip",
  "build": {
    "frontendDist": [
      "../index.html",
      "../pip.html",
      "../icons"
    ],
    "devUrl": "http://localhost:8520"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "饼控自律",
        "url": "/index.html",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "pip",
        "title": "饼控悬浮窗",
        "url": "/pip.html",
        "width": 264,
        "height": 124,
        "minWidth": 220,
        "minHeight": 108,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
